# Frontend environment variables. Copy this file to .env and fill in real values.

# Base URL of the backend API (used by fetch/axios calls)
REACT_APP_BACKEND_URL=http://localhost:5000

# "Run Code" goes through the backend at /api/judge/*, which proxies to the
# judge service configured on the backend as JUDGE_API_URL. No frontend
# variable is needed for the judge.