# Backend environment variables. Copy this file to .env and fill in real values.

# Port the API server listens on
PORT=5000

# MongoDB connection string (local default used when omitted)
MONGODB_URI=mongodb://localhost:27017/zcoder

# Secret used to sign JWTs. REQUIRED in production - use a long random string
# (e.g. `openssl rand -hex 32`). A dev-only fallback exists when unset.
JWT_SECRET=

# How long issued JWTs remain valid (default: 7d)
JWT_EXPIRES_IN=7d

# Groq API key used by the /api/ask-ai endpoint
GROQ_API_KEY=

# Base URL of the judge API. The app proxies /api/judge/* to this service.
JUDGE_API_URL=http://35.200.191.27:8000

# LeetCode problem-list mirror used by /api/problems (paginated + cached).
PROBLEMS_API_URL=https://leetcode-api-mu.vercel.app